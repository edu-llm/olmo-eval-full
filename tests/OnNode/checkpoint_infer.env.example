# Configuration for checkpoint_infer.py (Flow 1 on-node inference TEST).
# Copy to checkpoint_infer.env, fill in, and `source` it before invoking the script.

# --- Required ---
export RESULTS_BUCKET=          # S3 bucket for inference outputs, e.g. my-llm-bucket
export RUN_NAME=                # Groups all steps of one training run, e.g. olmo3-1b-v2

# --- Results location (optional) ---
export RESULTS_PREFIX=checkpoint-infer   # Prefix within RESULTS_BUCKET

# --- Checkpoint format (optional) ---
export CHECKPOINT_KIND=hf        # "hf" (HuggingFace dir) or "olmo_core" (raw trainer checkpoint)
# export OLMO_CORE_PACKAGE=      # Only for olmo_core: pin the ai2-olmo-core version if needed

# --- Inference sizing (optional; keep small to share the training node) ---
export NUM_PROMPTS=8             # Random prompts to run per checkpoint
export MAX_NEW_TOKENS=64         # Generation length cap
export TEMPERATURE=0.0           # 0.0 = greedy
export SEED=1234                 # Prompt-sampling + generation seed (fixed for comparability)
# export PROMPTS_FILE=           # Override the bundled prompts.jsonl

# --- Compute (optional) ---
export NUM_GPUS=1                # GPUs / tensor-parallel degree
# export CUDA_VISIBLE_DEVICES=7  # Pin the TEST to a spare GPU on the training node

# --- AWS (optional) ---
export AWS_REGION=us-east-1
# export S3_ENDPOINT_URL=        # For S3-compatible stores (MinIO, R2, ...)

# --- Invocation behavior (used by the training-script hook, not the script itself) ---
export BLOCKING=false            # false = run in background so training is not blocked
