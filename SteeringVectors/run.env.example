# Environment for the steering-vector checkpoint test (SteeringVectors/run_steering_eval.py).
# These are the knobs the .edullm/run.yaml command reads. For a local dry-run,
# `source` this file and run with --dry-run; for a platform run, set the same
# values in the submission environment.

# --- Required ---
export CHECKPOINT_S3=            # s3:// prefix of the checkpoint under test (HF-format dir), e.g.
                                 # s3://my-bucket/checkpoints/olmo3-1b/step10000/
export RESULTS_S3=               # s3:// prefix for outputs, e.g. s3://my-bucket/steering-eval

# --- Optional: what to steer and score ---
export TARGET_S3=               # Model the steering vector is applied to and scored on.
                                # Defaults to CHECKPOINT_S3 (self-steer).
export STEERING_DATASET=stereoset   # stereoset | sst2 | confaide | truthfulqa
export EVAL_DATASET=stereoset       # stereoset | sst2 | confaide (self-contained; no judge)
export LAYERS="16"              # Space/comma separated decoder layers to steer, e.g. "12 16 20"
export ALPHAS="-1"             # Space/comma separated intervention strengths, e.g. "-2 -1 1 2"

# --- Optional: sizing (keep bounded for cost) ---
export MAX_STATEMENTS=400       # Cap probing statements used to build the vector (0 = all)
export EVAL_LIMIT=200           # Cap eval examples (0 = whole test split)
export TRAIN_RATIO=0.5          # Fraction of probing statements used for the mean-difference
export EVAL_RATIO=0.5           # Test split starts at this fraction of the eval dataset
export SEED=1234

# --- Optional: run identity + AWS ---
export RUN_NAME=steering-eval    # Groups outputs under RESULTS_S3/<run>/step<N>/
export DEVICE=cuda:0
export AWS_REGION=us-east-1
# export S3_ENDPOINT_URL=        # For S3-compatible stores (MinIO, R2, ...)
