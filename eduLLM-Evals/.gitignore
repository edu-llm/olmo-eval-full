# Python build + caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.mplcache/
.pytest_cache/
build/
full200-results/
Full200Run/
# Calibration handoff bundle (huge; lives in S3/local, never in git) + extractions
qwen_calibration_handoff_32k_20260728/
qwen_calibration_handoff_32k_20260728.zip
handoff_extract/
supplement_handoff_build/
qwen_calibration_supplement_20260729.zip
# Ad-hoc local data dumps (hundreds of MB; regenerable from runs)
run_data.jsonl
run_data (1).csv
tutorbench_tb33_grading/
bridgegrade/
bridge_calibration/**/_tmp/
# Virtual environments
# ---------------------------------------------------------------------------
.venv
venv/
env/
ENV/

# ---------------------------------------------------------------------------
