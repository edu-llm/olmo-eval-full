# Virtual environments
venv/
ENV/
env/
.venv

# keep generated runs ignored by default
runs/

# allow human judge-validation grader packet artifacts
!runs/judge_validation_v1/
!runs/judge_validation_v1/grader_packets/
!runs/judge_validation_v1/grader_packets/*.md
!runs/judge_validation_v1/grader_packets/*.csv
!runs/judge_validation_v1/sample_scenarios.jsonl
!runs/judge_validation_v1/sample_rubrics.jsonl

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Project-specific output directories
runs/
cache/
dryrun/
smoke_runs/

# Data: the benchmark dataset IS tracked (needed on every machine that runs
# the pipeline); ignore only ad-hoc/derived jsonl dropped at the data/ root.
# (This glob is single-level, so per-benchmark subdirs like data/TutorBench/ and
# data/IFEval/ are tracked automatically.)
# the pipeline); ignore only ad-hoc/derived jsonl dropped at the data/ root.
# (This glob is single-level, so per-benchmark subdirs like data/TutorBench/ and
# data/IFEval/ are tracked automatically.)
data/*.jsonl
# TutorBench bank now lives under data/TutorBench/ (source + curated).
!data/TutorBench/scenarios.jsonl
!data/TutorBench/rubrics_qmatrix.jsonl
!data/TutorBench/rubrics_calibrated.jsonl
!data/TutorBench/rubrics_qmatrix_final.jsonl
# Curated bank (curation_v1) IS the finalized rubric + scenario schema — track it.
!data/TutorBench/curated/
!data/TutorBench/curated/rubrics_qmatrix_curated.jsonl
!data/TutorBench/curated/scenarios_curated.jsonl

# Curation intermediates: per-agent/batch op files + review dumps are scratch;
# the merged master spec (curation/pilot_edits.json) and reports ARE tracked.
curation/tranche/

# EduBench: candidate-bank scenario/rubric artifacts (HF-derived, reproducible via
# scripts/ingest_edubench.py / scripts/build_edubench_merged.py) -- never tracked,
# regardless of nesting depth (unmerged/, merged/, merged/<variant>/, given_qmat/, ...).
data/EduBench/**/scenarios.json
data/EduBench/**/scenarios.jsonl
data/EduBench/**/rubrics.json
data/EduBench/**/rubrics.jsonl
# Raw HF en_data/*.jsonl source (~90MB incl. model_predictions, reproducible) -- never tracked.
data/EduBench/en_data/

# AWS key pairs must never be committed
*.pem

# Generated plots (ignored by default; the curated set lives in plots/)
*.png
!plots/*.png

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.impeccable

tutorbench-responses/

# TutorEval processing intermediates: only the finalized bank (*_final.{jsonl,json})
# and the human-reviewed edit sheet (reframe_review.tsv) are tracked. The clean /
# coverage / reframed stage files are deterministically regenerable scratch and
# stay local (the scenario copies are ~6MB each).
data/TutorEval/*_clean.json
data/TutorEval/*_clean.jsonl
data/TutorEval/*_coverage.json
data/TutorEval/*_coverage.jsonl
data/TutorEval/*_reframed.json
data/TutorEval/*_reframed.jsonl

# q-matrix labeling scratch: per-run logs/manifests and sample outputs are
# regenerable and stay local. Only the finalized bank (*_final.{jsonl,json}) is tracked.
qmatrix_logs/
data/TutorEval/*_sample.json
data/TutorEval/*_sample.jsonl
data/TutorEval/*.sample.json
data/TutorEval/*.sample.jsonl
