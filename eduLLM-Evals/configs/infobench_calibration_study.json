    },
    {
      "name": "merge_format_linguistic_4d",
      "dimensions": "content=content,format_linguistic=format+linguistic,number=number,style=style",
      "status": "exploratory_from_full_fit"
    },
    {
      "name": "correlation_3d",
      "dimensions": "content_style=content+style,format=format,number_linguistic=number+linguistic",
      "status": "exploratory_from_full_fit"
    },
    {
      "name": "correlation_2d",
      "dimensions": "content_style=content+style,constraint_details=format+number+linguistic",
