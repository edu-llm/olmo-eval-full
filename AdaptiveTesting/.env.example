# Copy to AdaptiveTesting/.env and fill in. Loaded automatically by
# run_benchmark.py / judge_all.py (common.bootstrap_env) and read by
# Test/Inference/aws/put_hf_secret.sh when uploading the token to AWS.
# .env is gitignored - never commit real values.

# Required for gated repos (Llama / Gemma / Mistral / Pedagogy) and for any
# private dataset. Without it those ids 401 and are skipped.
HF_TOKEN=

# Where model + dataset caches live. Point this at a big disk; the 200-model
# sweep pulls hundreds of GB. aws/run_parallel.sh and cpu_sweep_200/
# run_cpu_worker.sh set it to <ROOT>/hf-cache on the workers.
# HF_HOME=

# 1 enables the Rust-based parallel downloader (needs `hf_transfer` installed).
# HF_HUB_ENABLE_HF_TRANSFER=1

# Absolute path to the sibling eduLLM-Evals checkout, only needed when the two
# repos are not side by side (FRQ scenario banks are read from it).
# EDULLM_EVALS_ROOT=
