# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
# Anchored with a leading slash. Unanchored, these match at every depth, which is
# how `results/step300/logs/` in the committed vLLM evidence went missing: the
# directory was tracked, the logs it existed to preserve were not.
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller. Its spec sits beside the entry point at the project root.
*.manifest
/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# uv
/logs/

# Eval output. `main` is an ordinary word, so unanchored this swallowed any
# directory of that name anywhere in the tree.
/main/

